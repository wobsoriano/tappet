{
  "name": "playwright-agent-device",
  "version": "0.0.0",
  "description": "Native mobile end-to-end tests with @playwright/test as the runner and agent-device as the driver.",
  "homepage": "https://github.com/wobsoriano/playwright-agent-device#readme",
  "bugs": {
    "url": "https://github.com/wobsoriano/playwright-agent-device/issues"
  },
  "license": "MIT",
  "author": "Robert Soriano",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wobsoriano/playwright-agent-device.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./core": {
      "types": "./dist/core/index.d.mts",
      "import": "./dist/core/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "test:e2e": "playwright test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^26.1.1",
    "agent-device": "0.20.10",
    "bumpp": "^11.1.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.63",
    "agent-device": ">=0.20.10"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.12"
  }
}
