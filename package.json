{
  "name": "tappet-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace for tappet, end-to-end testing for mobile apps with the Playwright test runner.",
  "type": "module",
  "scripts": {
    "check": "vp check",
    "test": "vp test",
    "build": "vp run -r build",
    "test:e2e": "pnpm --filter tappet-e2e test:e2e",
    "prepare": "vp config",
    "release": "vp exec changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "agent-device": "0.20.10",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.12"
  }
}
